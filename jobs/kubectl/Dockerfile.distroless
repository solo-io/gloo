ARG BASE_IMAGE=gcr.io/distroless/static-debian13:latest
ARG UTILS_DONOR_IMAGE

FROM cgr.dev/chainguard/kubectl:latest AS kubectl

FROM $UTILS_DONOR_IMAGE AS utils

FROM $BASE_IMAGE

COPY --from=kubectl /usr/bin/kubectl /usr/local/bin/kubectl
# The Helm jobs run shell scripts and use grep to check rollout status.
COPY --from=utils /bin/sh /bin/sh
COPY --from=utils /bin/grep /bin/grep

USER 10101
